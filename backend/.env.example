# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:4b
MAX_INPUT_CHARS=40000
REQUEST_TIMEOUT_SECONDS=180

# Agent Execution Mode
# Set to false for sequential execution (better performance on most hardware)
# Set to true for parallel execution (max 2 concurrent, requires more resources)
PARALLEL_AGENTS=false
